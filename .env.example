# Server & Security Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================================
# OPTION 1: Gmail SMTP (RECOMMENDED - Sends to ANY recipient email in the world!)
# ==============================================================================
# How to get your Gmail App Password (takes 1 minute, 100% free):
# 1. Go to your Google Account (myaccount.google.com)
# 2. Turn on "2-Step Verification" (Security tab)
# 3. Search for "App passwords" in the search bar
# 4. Create an App password (e.g., Name: "AeroDrop")
# 5. Copy the 16-character password and paste below:
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# EMAIL_FROM="AeroDrop Transfers <your_email@gmail.com>"
# EMAIL_PROVIDER=smtp

# ==============================================================================
# OPTION 2: Resend (Official SDK)
# ==============================================================================
# IMPORTANT:
# - If using 'onboarding@resend.dev', Resend strictly restricts sending ONLY to
#   your registered account email.
# - To send to ANY recipient email with Resend, you must verify your own custom
#   domain at https://resend.com/domains and set EMAIL_FROM="transfers@yourdomain.com".
#
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="AeroDrop Transfers <onboarding@resend.dev>"

# ==============================================================================
# OPTION 3: SendGrid
# ==============================================================================
# SENDGRID_API_KEY=SG.your_api_key_here

