# Transactional Email Provider Configuration

# Option 1: Resend (Recommended - Official SDK)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="AeroDrop <onboarding@resend.dev>"

# Option 2: SMTP (Gmail App Password, Amazon SES, Postmark SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password_here
# EMAIL_FROM="AeroDrop <your_email@gmail.com>"

# Option 3: SendGrid
# SENDGRID_API_KEY=SG.your_api_key_here
